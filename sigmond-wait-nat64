#!/bin/bash
# sigmond-wait-nat64 — block until this site's NAT64 prefix is discoverable.
#
# ⛔ WHY THIS EXISTS.  clatd finds the PLAT (NAT64) prefix by RFC 7050: it asks
# for AAAA records of `ipv4only.arpa`, a name that has ONLY A records, so any
# AAAA that comes back was synthesised by the site's DNS64 and carries the PLAT
# prefix.  That means clatd's startup DEPENDS ON A WORKING DNS64 RESOLVER -- and
# on an IPv6-only site the resolver arrives in a Router Advertisement (RDNSS),
# picked up by rdnssd, some seconds AFTER the network comes up.
#
# clatd does not wait, and worse, when discovery finds nothing it exits ZERO:
#
#     No PLAT prefix could be discovered. Your ISP probably doesn't provide
#     NAT64/DNS64 PLAT service. Exiting.
#     clatd.service: Deactivated successfully.
#
# systemd records that as success, so nothing ever retries and a lost boot race
# becomes a PERMANENT outage.  Measured on AI6VN-PM, 2026-09-29: clatd had
# exited at boot with Result=success/NRestarts=0 and no `clat` device existed,
# while `getent ahostsv6 ipv4only.arpa` answered fd4f:a955:ac3d:64::c000:aa the
# moment anyone looked.  The host had no IPv4 default route, so the IPv4-only
# decoder VM -- which reaches the world only through this CLAT -- had no egress
# during first-boot, and five components failed to fetch with "Failed to connect
# to github.com port 443 after 2 ms".  ka9q-web never got a systemd unit at all.
#
# So gate clatd on discovery actually working, and let systemd retry us.
#
#   exit 0  — a PLAT prefix is discoverable (or this host has native IPv4 and
#             clatd will stand down on its own, which is fine)
#   exit 1  — no prefix within the deadline; the caller should retry later
set -u
DEADLINE="${SIGMOND_NAT64_WAIT:-180}"     # seconds
INTERVAL="${SIGMOND_NAT64_INTERVAL:-5}"

say(){ printf 'sigmond-wait-nat64: %s\n' "$*"; }

# A host with a native IPv4 default route needs no CLAT.  clatd detects this and
# stands down by itself, so let it start and decide -- blocking here would spin
# forever on every ordinary dual-stack site.
#
# ⛔ BUT "HAS AN IPv4 DEFAULT ROUTE" IS NOT "HAS IPv4", AND THE DIFFERENCE COST
# US THE WHOLE GATE.  The PVE installer fossilises an unroutable
# 192.168.100.2/24 on vmbr0 when its own DHCP finds nothing, and the kernel duly
# installs `default via 192.168.100.1 dev vmbr0 proto kernel onlink linkdown`.
# That is a default route on a bridge with no carrier, going nowhere -- and the
# bare `grep -q .` above matched it.
#
# Measured on AI6VN-PM running v3.57, 2026-09-30 01:05:00Z:
#     sigmond-wait-nat64: host already has an IPv4 default route — no CLAT needed
#     clatd: No PLAT prefix could be discovered ... Exiting.
# The gate waved clatd straight through at the exact moment it was supposed to
# hold it back; clatd lost the discovery race and exited 0, permanently, exactly
# as before this script existed.  `getent ahostsv6 ipv4only.arpa` answered
# fd4f:a955:ac3d:64::c000:ab when anyone asked afterwards, so the wait would have
# succeeded.  The IPv4-only decoder VM was left with no egress at all.
#
# netfix deletes that fossil for the same reason -- it makes every later "do we
# have IPv4?" test lie.  This gate must not depend on netfix having got there
# first, so it re-asks the question honestly: a default route on an interface
# with CARRIER, that is not the installer's fallback.
native4=""
while read -r _r; do
    [ -n "$_r" ] || continue
    case "$_r" in
        *linkdown*)          continue ;;   # a route out a port with no cable
        *"via 192.168.100."*) continue ;;  # the PVE installer's fossil
    esac
    _d=${_r#*" dev "}; _d=${_d%% *}
    [ -n "$_d" ] || continue
    # A bridge with no ports reports carrier 0 (or nothing at all), which is the
    # honest answer for the fossil case and harmless for a real uplink.
    [ "$(cat "/sys/class/net/$_d/carrier" 2>/dev/null)" = 1 ] || continue
    native4="$_r"
    break
done <<EOF
$(ip -4 route show default 2>/dev/null)
EOF
if [ -n "$native4" ]; then
    say "host already has a working IPv4 default route — no CLAT needed"
    say "  $native4"
    exit 0
fi

# ── ⛔ AND clatd ASKS THE SAME NAIVE QUESTION ITSELF ────────────────────────
# Teaching this gate to see through the fossil was not enough, because clatd
# v2.1.0 runs its own check a few seconds later (clatd:892):
#
#     open(my $fd, '-|', cfg("cmd-ip"), qw(-4 route list default))
#     while(<$fd>) { if(/^default /) {
#         p("This system already has IPv4 connectivity; no need for a CLAT.");
#         cleanup_and_exit(0); } }
#
# Any default route at all, `linkdown` or not.  So on the v3.59 install of
# AI6VN-PM the gate did its job perfectly and clatd still stood down:
#
#     04:52:27  clatd starts; gate says "NAT64 prefix discoverable" -> exit 0
#     04:52:38  clatd's own check sees the fossil -> "already has IPv4" -> exit 0
#     04:53:29  netfix removes the fossil -- 51 seconds too late
#
# netfix cannot win that race by construction: it spends 30 s in the carrier
# wait before it can conclude anything, and clatd's check fires at 10 s.
#
# Fixing it in clatd's config would mean disabling v4-conncheck outright, which
# would break the ordinary dual-stack site where standing down is CORRECT.  So
# remove the LIE instead of teaching each consumer about it: by here we have
# established there is no usable IPv4 default route, and every route still in
# the table is therefore one that goes nowhere.  Drop them, and clatd's check
# then sees the truth.  netfix removes the matching address later; this only
# needs to get there first.
#
# ⚠ Rebuild the spec from its parts rather than feeding the line back to `ip`.
# `linkdown` is a STATUS flag in the output, not something `ip route del`
# accepts, so `ip route del $line` fails on exactly the routes we care about.
while read -r _r; do
    [ -n "$_r" ] || continue
    case "$_r" in
        *linkdown*|*"via 192.168.100."*) ;;
        *) continue ;;                      # not ours to touch
    esac
    _gw=${_r#*" via "}; _gw=${_gw%% *}
    _dv=${_r#*" dev "}; _dv=${_dv%% *}
    [ -n "$_gw" ] && [ -n "$_dv" ] || continue
    if ip -4 route del default via "$_gw" dev "$_dv" 2>/dev/null; then
        say "removed a default route that goes nowhere, so clatd is not fooled by it"
        say "  was: $_r"
    fi
done <<EOF
$(ip -4 route show default 2>/dev/null)
EOF

end=$(( $(date +%s) + DEADLINE ))
while :; do
    # Any AAAA for ipv4only.arpa is by definition DNS64-synthesised.
    if getent ahostsv6 ipv4only.arpa 2>/dev/null | grep -qE '^[0-9a-fA-F:]+[[:space:]]'; then
        say "NAT64 prefix discoverable: $(getent ahostsv6 ipv4only.arpa \
             | awk 'NR==1{print $1}')"
        exit 0
    fi
    now=$(date +%s)
    [ "$now" -ge "$end" ] && break
    sleep "$INTERVAL"
done

say "no NAT64 prefix discoverable after ${DEADLINE}s — not starting clatd yet"
say "  (if this site really has no NAT64, clatd is simply not applicable here)"
exit 1
