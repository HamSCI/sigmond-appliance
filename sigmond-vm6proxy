#!/bin/bash
# sigmond-vm6proxy — let IPv6 clients reach the IPv4-only decoder VM.
#
# ⛔ WHY DNAT CANNOT DO THIS.  The host forwards the VM's operator-facing ports
# with `iptables -t nat ... DNAT --to-destination 10.99.0.2:PORT`.  That is
# IPv4-to-IPv4.  A NAT rule cannot change address family, and the VM is IPv4-only
# BY DESIGN (see sigmond/tasks/plan-ipv6-support.md §3: the VM never learns IPv6,
# the host translates).  So on an IPv6-only site an operator reaching the host
# over v6 finds ssh working -- the host's own sshd listens on v6 -- and every
# forwarded web port dead.  Measured on AI6VN-PM after the v3.55 install,
# 2026-09-29: IPv4 DNAT rules present, `ip6tables -t nat -S PREROUTING` empty.
#
# The fix is a userspace relay: accept on IPv6, connect to the VM over the
# host-only /30.  systemd-socket-proxyd ships with systemd, so nothing new is
# installed, and socket activation means a port with no service behind it costs
# nothing until someone connects.
#
# IPv6-ONLY sockets on purpose: the existing IPv4 DNAT already handles v4 and is
# faster (in-kernel).  Binding dual-stack here would put a userspace hop in the
# path of traffic that works today.
#
# Every host gets it, not only an IPv6-only one (v3.72 #15): a dual-stack site
# had no IPv6 way to the VM's pages, and a site whose router turns IPv6 on later
# needs it already in place.  The importer installs it beside the IPv4 DNAT
# rules; pm-align brings it to hosts installed before that.  A host whose kernel
# has IPv6 off skips the units through their Condition, quietly.
#
# install never waits on a unit: it enables each socket and starts it with
# --no-block.  The v6 gateway runs it from units that are part of getting the
# network online, and firstboot-v3.sh forbids a synchronous start there.
#
# LOCAL NETWORKS ONLY (Michael, 2026-10-15).  NAT keeps the VM's IPv4 ports on
# the site's own network.  A global IPv6 address has no NAT in front of it, so
# wherever the site router does not filter inbound IPv6, the relay would answer
# the whole internet -- ssh on 2222 included.  So each socket unit carries
#     IPAddressDeny=any
#     IPAddressAllow=localhost link-local
# and a drop-in, sigmond-vm6proxy@.socket.d/10-allow-local.conf, carries
# IPAddressDeny=any again plus the prefixes of this host's own IPv6 addresses
# on its uplink, global and ULA (never its routes, never a tunnel's ULA; see
# local_prefixes, which also records the residual risk).  The drop-in denies
# on its own because Allow without Deny filters nothing: an older
# sigmond-vm6proxy rewrites the socket units without Deny, and the drop-in
# still closes them.  systemd applies a socket unit's access list to the
# listening socket (systemd.resource-control(5)), which drops a connection
# from anywhere else; a daemon-reload re-applies a changed list to the live
# listener (final review, systemd 257).  The service units carry no list:
# proxyd connects out to the VM over IPv4.  allow-refresh recomputes the
# drop-in; a timer runs it every 15 minutes, so a renumbered prefix, or a
# router that turns IPv6 on later, reaches the list without a reinstall.
#
#   sigmond-vm6proxy install [--no-status] [vm-ip]
#                                      write + enable the units (idempotent);
#                                      --no-status skips the VM probe
#   sigmond-vm6proxy allow-refresh     recompute the local-prefix allow list
#   sigmond-vm6proxy status            per port: the effective filter and the VM
#   sigmond-vm6proxy remove
set -u
VM_IP="${SIGMOND_MGMT_VM:-10.99.0.2}"
UNITDIR=/etc/systemd/system
# The tests point this elsewhere, and only with their flag set: production
# never reads the variable alone.
if [ "${SIGMOND_VM6PROXY_TEST:-}" = 1 ] && [ -n "${SIGMOND_VM6PROXY_UNITDIR:-}" ]; then
    UNITDIR="$SIGMOND_VM6PROXY_UNITDIR"
fi
# listen:target -- 2222 maps to the VM's 22 because the host's own sshd owns 22.
# 8765 is mag-usb's live sample feed.  Without it the magnetometer dashboard
# loads over IPv6 and then sits "disconnected" for ever, because the page can
# reach :8082 and its websocket cannot reach the instrument (AI6VN 2026-09-30).
PORTS="8000:8000 8081:8081 8082:8082 8765:8765 2222:22"
PROXY=/lib/systemd/systemd-socket-proxyd
[ -x "$PROXY" ] || PROXY=/usr/lib/systemd/systemd-socket-proxyd
LOCAL_ALLOW="localhost link-local"
DROPDIR="${UNITDIR}/sigmond-vm6proxy@.socket.d"
DROPIN="${DROPDIR}/10-allow-local.conf"
SELF=/usr/local/sbin/sigmond-vm6proxy

say(){ printf '%s\n' "$*"; }

# put_unit <path>: write stdin there only when the bytes differ.  Exit 0 and
# print "changed" when it wrote, 0 and nothing when they matched, 1 on failure.
put_unit(){
    local dest="$1" tmp="$1.vm6new"
    { cat > "$tmp"; } 2>/dev/null || { rm -f "$tmp"; say "cannot write $dest"; return 1; }
    if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then rm -f "$tmp"; return 0; fi
    mv -f "$tmp" "$dest" || { rm -f "$tmp"; say "cannot write $dest"; return 1; }
    echo changed
}

# The prefixes of this host's OWN IPv6 addresses on its UPLINK, global and
# ULA, each address masked to its prefix length, /48 to /64 only.  An own
# /128 (stateful DHCPv6, IA_NA) stands for its /64.  ULA counts only this way:
# no blanket fc00::/7, because overlay VPNs (Tailscale fd7a:115c:a1e0::/48,
# ZeroTier) hand their peers ULA addresses (final review 2026-10-15).
#
# Never the routing table: anyone on the LAN can send a router advertisement,
# and a forged RA announcing an on-link ::/1 or 2000::/3 makes the kernel add
# that route (security review 2026-10-15).  A route counts for nothing.
#
# The uplink only: the device(s) that carry the default IPv6 route, or vmbr0
# when there is none.  Never vmbr1 (the VM's link), never a tunnel (wg*, tun*,
# tailscale*, frp*, clat*): a VPN or a second uplink holding a global address
# must not open its whole prefix (security review 2026-10-15).
#
# Skipped: tentative, dadfailed and deprecated addresses, other prefix
# lengths, link-local, multicast.
#
# RESIDUAL RISK, accepted (controller ruling 2026-10-15): a hostile host on the
# station's own LAN can send a router advertisement whose /64 makes this host
# autoconfigure an address there, and that /64 then enters the list.  That
# needs an attacker already on the local network, which "local networks only"
# trusts by definition.  The rule stays: own uplink addresses, /48 to /64.
#
# This runs as root (install, allow-refresh, pm-align, the timer), so python
# runs isolated: /usr/bin/python3 -I (no cwd or script dir on sys.path, no
# PYTHON* variables, no user site), from /.  A planted ipaddress.py cannot run.
# Without /usr/bin/python3 the list stays local-only, which fails safe.
#
# Sorted, one line, space-separated.
uplinks(){
    local devs
    devs=$(ip -6 route show default 2>/dev/null \
        | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1) }' \
        | grep -vE '^(lo|vmbr1|wg.*|tun.*|tailscale.*|frp.*|clat.*)$' | sort -u | tr '\n' ' ')
    [ -n "${devs// /}" ] || devs=vmbr0
    printf '%s\n' "$devs"
}

local_prefixes(){
    [ -x /usr/bin/python3 ] || return 0
    local devs
    devs=$(uplinks)
    # shellcheck disable=SC2086  # one argument per device
    ( cd / && ip -6 -o addr show scope global 2>/dev/null | /usr/bin/python3 -I -c '
import ipaddress, sys
UPLINKS = set(sys.argv[1:])
LL = ipaddress.ip_network("fe80::/10")
MC = ipaddress.ip_network("ff00::/8")
out = set()
for line in sys.stdin:
    f = line.split()
    if "inet6" not in f or len(f) < 4:
        continue
    if "tentative" in f or "dadfailed" in f or "deprecated" in f:
        continue
    if f[1].split("@")[0] not in UPLINKS:
        continue
    try:
        iface = ipaddress.IPv6Interface(f[f.index("inet6") + 1])
    except ValueError:
        continue
    net = iface.network
    if net.prefixlen == 128:
        net = ipaddress.IPv6Interface(f"{iface.ip}/64").network
    if not 48 <= net.prefixlen <= 64:
        continue
    if net.subnet_of(LL) or net.subnet_of(MC):
        continue
    out.add(str(net))
print(" ".join(sorted(out)))
' $devs 2>/dev/null )
}

restart_sockets(){   # try-restart: an inactive socket stays as it is
    local lp
    for lp in "$@"; do
        systemctl try-restart --no-block "sigmond-vm6proxy@${lp}.socket" >/dev/null 2>&1
    done
}


# write_dropin: 0 and "changed" when it rewrote the drop-in, 0 and nothing
# when it matched, 1 on failure.  No reload, no restart.
write_dropin(){
    local pfx allow
    pfx=$(local_prefixes)
    allow="$LOCAL_ALLOW${pfx:+ $pfx}"
    mkdir -p "$DROPDIR" 2>/dev/null || { say "cannot create $DROPDIR"; return 1; }
    put_unit "$DROPIN" <<EOF
# Written by sigmond-vm6proxy allow-refresh; rewritten when the prefixes change.
# The relay answers this host's own networks only.  Deny is repeated here
# because Allow without Deny filters nothing, and an older sigmond-vm6proxy
# writes socket units without it.
[Socket]
IPAddressDeny=any
IPAddressAllow=${allow}
EOF
}

cmd_allow_refresh(){
    local r
    r=$(write_dropin) || { say "$r"; return 1; }
    if [ "$r" = changed ]; then
        # A reload alone applies the new list to the live listening socket.
        # No restart: that would also restart each proxyd (the service
        # Requires= its socket) and drop every relayed session.
        systemctl daemon-reload
        say "allow list now: $(grep '^IPAddressAllow=' "$DROPIN" | cut -d= -f2-)"
    fi
    return 0
}

cmd_install(){
    [ -x "$PROXY" ] || { say "systemd-socket-proxyd not found -- cannot proxy"; return 1; }
    local pair lp tp r changed=""
    for pair in $PORTS; do
        lp="${pair%%:*}"; tp="${pair##*:}"
        r=$(put_unit "${UNITDIR}/sigmond-vm6proxy@${lp}.socket" <<EOF
[Unit]
Description=IPv6 listener for the decoder VM's port ${lp}
Documentation=man:systemd-socket-proxyd(8)
# A kernel with IPv6 off has no such file: skip quietly, no failed unit.
ConditionPathExists=/proc/net/if_inet6

[Socket]
# IPv6 ONLY: IPv4 already reaches the VM through the in-kernel DNAT rule, and
# putting a userspace hop in front of that would be a regression.
ListenStream=[::]:${lp}
BindIPv6Only=ipv6-only
Accept=no
# Local networks only.  The drop-in in sigmond-vm6proxy@.socket.d adds the
# prefixes of this host's own global addresses; everything else is refused.
IPAddressDeny=any
IPAddressAllow=${LOCAL_ALLOW}

[Install]
WantedBy=sockets.target
EOF
) || { say "$r"; return 1; }
        [ "$r" = changed ] && changed="$changed $lp"
        r=$(put_unit "${UNITDIR}/sigmond-vm6proxy@${lp}.service" <<EOF
[Unit]
Description=Relay IPv6 :${lp} to the decoder VM ${VM_IP}:${tp}
ConditionPathExists=/proc/net/if_inet6
Requires=sigmond-vm6proxy@${lp}.socket
After=sigmond-vm6proxy@${lp}.socket

[Service]
ExecStart=${PROXY} ${VM_IP}:${tp}
# The VM may be down or still booting; a dead relay must not mask that as a
# failed unit the operator has to clear.
Restart=no
EOF
) || { say "$r"; return 1; }
        [ "$r" = changed ] && changed="$changed $lp"
    done
    r=$(put_unit "${UNITDIR}/sigmond-vm6proxy-refresh.service" <<EOF
[Unit]
Description=Recompute the IPv6 relay's local-network allow list
ConditionPathExists=/proc/net/if_inet6

[Service]
Type=oneshot
ExecStart=${SELF} allow-refresh
EOF
) || { say "$r"; return 1; }
    r=$(put_unit "${UNITDIR}/sigmond-vm6proxy-refresh.timer" <<EOF
[Unit]
Description=Follow this host's IPv6 prefixes into the relay's allow list

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
EOF
) || { say "$r"; return 1; }
    # A changed drop-in needs only the reload below (see cmd_allow_refresh).
    r=$(write_dropin) || { say "$r"; return 1; }
    systemctl daemon-reload
    # Sockets whose text changed restart (try-restart: only a running one);
    # unchanged ones are left alone.
    [ -n "$changed" ] && restart_sockets $(printf '%s\n' $changed | sort -u)
    for pair in $PORTS; do
        lp="${pair%%:*}"
        systemctl enable "sigmond-vm6proxy@${lp}.socket" >/dev/null 2>&1
        systemctl start --no-block "sigmond-vm6proxy@${lp}.socket" >/dev/null 2>&1
    done
    systemctl enable sigmond-vm6proxy-refresh.timer >/dev/null 2>&1
    systemctl start --no-block sigmond-vm6proxy-refresh.timer >/dev/null 2>&1
    say "allow list: $(grep '^IPAddressAllow=' "$DROPIN" | cut -d= -f2-)"
    [ "$NO_STATUS" = 1 ] || cmd_status
}

cmd_status(){
    local pair lp tp st deny filt vm
    for pair in $PORTS; do
        lp="${pair%%:*}"; tp="${pair##*:}"
        st=$(systemctl is-active "sigmond-vm6proxy@${lp}.socket" 2>/dev/null)
        # What systemd enforces, not what the files say: an empty Deny list
        # means the port answers any address.
        deny=$(systemctl show -p IPAddressDeny --value "sigmond-vm6proxy@${lp}.socket" 2>/dev/null)
        if [ -n "${deny// /}" ]; then filt="filtered"; else filt="NOT FILTERED"; fi
        # Report whether the VM is actually serving, not merely whether we
        # listen.  VM_IP is a checked dotted quad (valid_ipv4 at the top).
        if timeout 3 bash -c "exec 3<>/dev/tcp/${VM_IP}/${tp}" 2>/dev/null; then
            vm="VM=serving"
        else
            vm="VM=NOT serving (nothing to reach yet)"
        fi
        printf '  :%-5s -> %s:%-5s  socket=%-8s %-12s %s\n' "$lp" "$VM_IP" "$tp" "$st" "$filt" "$vm"
    done
}

cmd_remove(){
    local pair lp
    systemctl disable --now sigmond-vm6proxy-refresh.timer >/dev/null 2>&1
    for pair in $PORTS; do
        lp="${pair%%:*}"
        systemctl disable --now "sigmond-vm6proxy@${lp}.socket" >/dev/null 2>&1
        rm -f "${UNITDIR}/sigmond-vm6proxy@${lp}.socket" \
              "${UNITDIR}/sigmond-vm6proxy@${lp}.service"
    done
    rm -f "${UNITDIR}/sigmond-vm6proxy-refresh.timer" "${UNITDIR}/sigmond-vm6proxy-refresh.service"
    rm -rf "$DROPDIR"
    systemctl daemon-reload
    say "removed"
}

# A dotted quad, each octet 0-255.  VM_IP reaches the units and a root
# `bash -c` in the status probe, so nothing else gets through.
valid_ipv4(){
    local ip="$1" o
    [[ "$ip" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
    local IFS=.
    for o in $ip; do [ $((10#$o)) -le 255 ] || return 1; done
    return 0
}

NO_STATUS=0
CMD="${1:-status}"; [ $# -gt 0 ] && shift
if [ "$CMD" = install ]; then
    [ "${1:-}" = --no-status ] && { NO_STATUS=1; shift; }
    [ $# -gt 0 ] && VM_IP="$1"
fi
if ! valid_ipv4 "$VM_IP"; then
    say "sigmond-vm6proxy: not an IPv4 address: $(printf '%s' "$VM_IP" | LC_ALL=C tr -c ' -~' '?')"
    exit 2
fi

case "$CMD" in
    install) cmd_install ;;
    allow-refresh) cmd_allow_refresh ;;
    status)  cmd_status ;;
    remove)  cmd_remove ;;
    *) say "usage: sigmond-vm6proxy {install [--no-status] [vm-ip] | allow-refresh | status | remove}"; exit 2 ;;
esac
