#!/bin/bash
# sigmond-site-timing — wire hf-timestd's timing chain to the local site.
# Runs INSIDE the decoder VM; installed by sigmond-setup, invoked by the
# SDR sentinel after each successful bringup, and safe to rerun any time
# (every step skips when already wired). Encodes what used to be manual
# post-install work (rob 2026-07-29: NO manual-only fixes — anything the
# live station needed by hand must be in the greenfield flow):
#   1. chrony refclocks for the timestd FUSE/HPPS feed
#   2. LAN stratum-1 NTP discovery → chrony local time servers
#   3. metrology channel env files (from [station]) + per-channel instances
#   4. LAN GNSS UBX stream discovery (:9000) → [gnss_vtec]
#   5. timestd profile "full"
#   6. hs-uploader key ownership repair (sigmond#41 family, until upstream fix)
set -u
say(){ echo "[site-timing] $*" | systemd-cat -t sigmond-site-timing -p notice; }
command -v timestd >/dev/null 2>&1 || { say "hf-timestd not installed - skipping"; exit 0; }
CFG=/etc/hf-timestd/timestd-config.toml
SUBNET=$(ip -4 route | awk '/proto kernel/{print $1; exit}')

# ── 1. chrony refclocks (FUSE/HPPS) ─────────────────────────────────────────
CHANGED=0
RC=/opt/git/sigmond/hf-timestd/config/chrony-timestd-refclocks.conf
if [ -f "$RC" ] && [ ! -f /etc/chrony/conf.d/chrony-timestd-refclocks.conf ]; then
    cp "$RC" /etc/chrony/conf.d/ && CHANGED=1 && say "chrony FUSE/HPPS refclocks installed"
fi

# ── 2. LAN stratum-1 NTP servers ────────────────────────────────────────────
if [ -n "$SUBNET" ] && [ ! -f /etc/chrony/conf.d/local-timeservers.conf ]; then
    NTP1=$(python3 - "$SUBNET" <<'PYEOF'
import ipaddress, socket, sys, concurrent.futures
net = ipaddress.ip_network(sys.argv[1], strict=False)
def q(ip):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(1)
        s.sendto(b'\x1b' + 47*b'\0', (str(ip),123)); d,_ = s.recvfrom(512); s.close()
        if d[1] == 1: return str(ip)
    except Exception: pass
if net.num_addresses <= 1024:
    with concurrent.futures.ThreadPoolExecutor(64) as ex:
        for r in ex.map(q, net.hosts()):
            if r: print(r)
PYEOF
)
    if [ -n "$NTP1" ]; then
        for ip in $NTP1; do echo "server $ip iburst minpoll 4 maxpoll 6"; done \
            > /etc/chrony/conf.d/local-timeservers.conf
        CHANGED=1; say "local stratum-1 NTP wired: $(echo $NTP1 | tr '\n' ' ')"
    else
        say "no local stratum-1 NTP found - public pool only"
    fi
fi
[ "$CHANGED" = 1 ] && systemctl restart chrony 2>/dev/null

# ── 2.5 identity reconciliation (relocation support) ───────────────────────
# Stations may be staged at one site and deployed at another (rob
# 2026-08-04: build in Scranton, deploy elsewhere). `sigmond-setup
# --reconfigure` updates site-profile + re-renders the main configs, but
# three places keep their own copy of grid/lat/lon and previously skipped
# regeneration when the files existed. Reconcile them against the
# canonical site-profile grid whenever they drift.
CANON=$(python3 - <<'PYEOF'
import tomllib
try:
    sp = tomllib.load(open('/etc/sigmond/site-profile.toml','rb'))
    g = (sp.get('station',{}).get('grid_square') or '').strip()
    if len(g) >= 4:
        g6 = (g + 'mm')[:6].upper()
        lon = (ord(g6[0])-65)*20 - 180 + int(g6[2])*2 + (ord(g6[4])-65)*(2/24) + 1/24
        lat = (ord(g6[1])-65)*10 -  90 + int(g6[3])   + (ord(g6[5])-65)*(1/24) + 1/48
        print("%s %.4f %.4f" % (g, lat, lon))
except Exception:
    pass
PYEOF
)
if [ -n "$CANON" ]; then
    set -- $CANON; G="$1"; LAT="$2"; LON="$3"
    # hf-timestd [station]
    if [ -f "$CFG" ] && ! grep -q "grid_square = \"$G\"" "$CFG"; then
        sed -i -e "s|^grid_square = .*|grid_square = \"$G\"|" \
               -e "s|^latitude = .*|latitude = $LAT|" \
               -e "s|^longitude = .*|longitude = $LON|" "$CFG" \
            && say "relocation: hf-timestd [station] -> $G ($LAT, $LON)"
    fi
    # metrology channel envs: regenerate on grid drift
    if [ -d /etc/hf-timestd/metrology-channels ] && \
       ! grep -q "GRID_SQUARE=$G" /etc/hf-timestd/metrology-channels/*.env 2>/dev/null; then
        rm -rf /etc/hf-timestd/metrology-channels
        say "relocation: metrology channel envs stale — regenerating for $G"
        RESTART_METROLOGY=1
    fi
    # mag-recorder
    MAGCFG=/etc/mag-recorder/mag-recorder-config.toml
    if [ -f "$MAGCFG" ] && ! grep -q "grid_square      = \"$G\"" "$MAGCFG"; then
        sed -i -e "s|^grid_square      = .*|grid_square      = \"$G\"|" \
               -e "s|^latitude         = .*|latitude         = $LAT|" \
               -e "s|^longitude        = .*|longitude        = $LON|" "$MAGCFG" \
            && systemctl try-restart mag-recorder 2>/dev/null \
            && say "relocation: mag-recorder -> $G"
    fi
fi

# ── 3. metrology channel instances ──────────────────────────────────────────
# env files from [station] (populated by sigmond config render) + one
# timestd-metrology@ instance per channel. WWV/WWVH set only — CHU is off
# the air; upstream install.sh still lists it (flagged to mjh).
MC=/etc/hf-timestd/metrology-channels
if [ -f "$CFG" ] && [ ! -d "$MC" ]; then
    GEN=$(python3 - "$CFG" "$MC" <<'PYEOF'
import sys, tomllib, os
cfg, mc = sys.argv[1], sys.argv[2]
c = tomllib.load(open(cfg, 'rb'))
s = c.get('station', {})
if not s.get('callsign') or not s.get('id'):
    print("skip"); raise SystemExit
r = c.get('recorder', {})
aroot = "/dev/shm/timestd/raw_buffer" if r.get('tiered_storage', False) else "/var/lib/timestd/raw_buffer"
os.makedirs(mc, exist_ok=True)
for name, hz in [("SHARED_2500",2500000),("SHARED_5000",5000000),
                 ("SHARED_10000",10000000),("SHARED_15000",15000000),
                 ("WWV_20000",20000000),("WWV_25000",25000000)]:
    open(os.path.join(mc, name + ".env"), "w").write(
"""# Auto-generated by sigmond-site-timing
# Channel: %s
FREQUENCY_HZ=%d
CALLSIGN=%s
GRID_SQUARE=%s
STATION_ID=%s
INSTRUMENT_ID=%s
LATITUDE=%s
LONGITUDE=%s
DATA_ROOT=/var/lib/timestd
ARCHIVE_ROOT=%s
""" % (name, hz, s.get('callsign',''), s.get('grid_square',''), s.get('id',''),
       s.get('instrument_id',''), s.get('latitude',''), s.get('longitude',''), aroot))
print("ok")
PYEOF
)
    if [ "$GEN" = "ok" ]; then
        chown -R timestd:timestd "$MC" 2>/dev/null
        say "metrology channel env files generated (6 x WWV/WWVH)"
    else
        say "station identity incomplete - metrology channels skipped"
    fi
fi
if [ -d "$MC" ]; then
    for f in "$MC"/*.env; do
        [ -f "$f" ] || continue
        if [ "${RESTART_METROLOGY:-0}" = 1 ]; then
            systemctl restart "timestd-metrology@$(basename "$f" .env)" 2>/dev/null
            systemctl enable "timestd-metrology@$(basename "$f" .env)" 2>/dev/null
        else
            systemctl enable --now "timestd-metrology@$(basename "$f" .env)" 2>/dev/null
        fi
    done
    [ "${RESTART_METROLOGY:-0}" = 1 ] && systemctl try-restart timestd-fusion 2>/dev/null
fi

# ── 4. local GNSS UBX stream → [gnss_vtec] ──────────────────────────────────
if [ -n "$SUBNET" ] && [ -f "$CFG" ] && grep -q '<YOUR_GNSS_HOST>' "$CFG"; then
    GHOST=$(python3 - "$SUBNET" <<'PYEOF'
import ipaddress, socket, sys, concurrent.futures
net = ipaddress.ip_network(sys.argv[1], strict=False)
def probe(ip):
    try:
        s = socket.create_connection((str(ip), 9000), timeout=1); s.settimeout(2)
        d = b""
        try:
            while len(d) < 64: d += s.recv(64)
        except socket.timeout: pass
        s.close()
        if b"\xb5\x62" in d: return str(ip)
    except Exception: pass
if net.num_addresses <= 1024:
    with concurrent.futures.ThreadPoolExecutor(64) as ex:
        for r in ex.map(probe, net.hosts()):
            if r: print(r); break
PYEOF
)
    if [ -n "$GHOST" ]; then
        cp -p "$CFG" "$CFG.bak-site-timing"
        python3 - "$CFG" "$GHOST" <<'PYEOF'
import re, sys
p, host = sys.argv[1], sys.argv[2]
s = open(p).read()
def sub(s, key, val):
    pat = re.compile(r"(\[gnss_vtec\].*?)(^" + key + r"\s*=\s*[^\n]*)", re.S | re.M)
    return pat.sub(lambda m: m.group(1) + key + " = " + val, s, count=1)
s = sub(s, "enabled", "true  # auto-wired by sigmond-site-timing")
s = sub(s, "host", '"%s"' % host)
open(p, "w").write(s)
PYEOF
        say "GNSS UBX stream found: $GHOST:9000 - gnss_vtec enabled"
        # an already-running vtec service read the config before this edit
        systemctl try-restart timestd-vtec 2>/dev/null
    else
        say "no local GNSS UBX stream on :9000 - vtec stays off"
    fi
fi

# ── 4.5 meteor-scatter (MSK144) — dasi2 appliance policy: ON ────────────────
# The catalog marks meteor-scatter optional, so bringup neither configures
# it nor mints its instance; and `instance add` seeds no radiod/channel
# config at all (three mjh flags: catalog policy, _REPORTER_KEYED, a
# non-interactive meteor config path). Generate the working config here —
# identical to the hand-validated 2026-07-29 B4 deployment.
if [ -d /opt/git/sigmond/meteor-scatter ] && command -v smd >/dev/null 2>&1; then
    REPORTER=$(python3 - <<'PYEOF'
import tomllib
try:
    c = tomllib.load(open('/etc/sigmond/site-profile.toml','rb'))
    print(c.get('reporters',{}).get('reporter_id') or c.get('station',{}).get('callsign') or '')
except Exception: print('')
PYEOF
)
    RADID=$(ls /etc/radio/radiod@*.conf 2>/dev/null | head -1 | sed 's/.*radiod@\(.*\)\.conf/\1/')
    if [ -n "$REPORTER" ] && [ -n "$RADID" ]; then
        INST=$(echo "$REPORTER" | tr '/' '=')
        MCONF="/etc/meteor-scatter/$INST.toml"
        if ! grep -q '\[\[radiod\]\]' "$MCONF" 2>/dev/null; then
            smd install --components meteor-scatter --yes >/dev/null 2>&1
            smd admin instance add --force meteor-scatter "$REPORTER" >/dev/null 2>&1
            python3 - "$MCONF" "$REPORTER" "$RADID" <<'PYEOF'
import sys, tomllib
p, reporter, radid = sys.argv[1], sys.argv[2], sys.argv[3]
sp = tomllib.load(open('/etc/sigmond/site-profile.toml','rb'))
st = sp.get('station', {})
open(p, 'w').write("""# Per-instance config for meteor-scatter@%s
# Auto-generated by sigmond-site-timing (validated live on B4 2026-07-29)

[instance]
reporter_id = "%s"
sources = ["radiod:%s"]

[station]
callsign    = "%s"
grid_square = "%s"

[[radiod]]
status = "%s-status.local"

[radiod.msk144]
sample_rate   = 12000
preset        = "usb"
encoding      = "s16be"
tr_period_sec = 30
freqs_hz      = [
  28_145_000,
  50_260_000,
]
""" % (reporter.replace('/','='), reporter, radid,
       st.get('callsign',''), st.get('grid_square',''), radid))
PYEOF
            systemctl enable --now "meteor-scatter@$(systemd-escape "$INST")" 2>/dev/null \
                && say "meteor-scatter@$INST configured + started (MSK144 10m/6m)" \
                || say "WARN: meteor-scatter@$INST failed to start - check journal"
        fi
    fi
fi

# ── 4.7 ka9q-web ─────────────────────────────────────────────────────────────
# The sentinel-driven bringup can end with radiod running but NO ka9q-web
# unit written (unit-writer needs the radiod status name; the bringup
# re-install step didn't fire on the 2026-07-30 field greenfield — mjh
# flag). Ensure it here, after radiod exists.
if ls /etc/radio/radiod@*.conf >/dev/null 2>&1 && ! systemctl list-unit-files --no-legend 'ka9q-web*' 2>/dev/null | grep -q ka9q-web; then
    smd install --components ka9q-web --yes >/dev/null 2>&1
    systemctl enable --now ka9q-web 2>/dev/null \
        && say "ka9q-web installed + started (:8081)" \
        || say "WARN: ka9q-web install/start failed - check smd status"
fi

# ── 5. full timing profile ──────────────────────────────────────────────────
timestd profile set full >/dev/null 2>&1 && say "timestd profile: full"

# ── 6. hs-uploader key ownership (sigmond#41 family) ────────────────────────
# minted key comes out root-owned -> hsupload gets Permission denied every
# SFTP tar cycle and silently falls back to FTP. Real fix belongs in
# sigmond's key mint; repair here until it lands.
id hsupload >/dev/null 2>&1 && chown -R hsupload:sigmond /etc/hs-uploader/keys 2>/dev/null
exit 0
